# Border AI Sentinel — environment template
# Copy to .env and fill in values. Never commit .env.

APP_NAME=Border AI Sentinel
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
API_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vision
DETECTION_MODEL_PATH=vision/models/yolov8n.pt
DETECTION_CONFIDENCE=0.45
DETECTION_DEVICE=cpu
TRACKER_MAX_AGE=30

# Risk
RISK_HIGH_THRESHOLD=0.75
RISK_MEDIUM_THRESHOLD=0.45

# Evidence
EVIDENCE_OUTPUT_DIR=data/demo
CLIP_SECONDS_BEFORE=4
CLIP_SECONDS_AFTER=4
